<?xml version="1.0" encoding="utf-8"?>
<!-- Needs attention: a header (or, with nothing past due, the green check
     line), up to five invoice rows each with an optional small section label
     above it ("Due soon", "Next due"), an Outstanding block when a tall widget
     has room left, and the footer. AttentionWidgetProvider fills it and decides
     what fits. Fixed rows rather than a collection: a RemoteViews list needs a
     service, and five rows is the most this shows. The root is
     @android:id/background, the view Android 12+ animates the app launch from. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <TextView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Nothing past due: in the header's place, a check (a glyph, so it reads
         without colour) and the words, semibold. The framework drawableStart,
         not AppCompat's: RemoteViews inflate with no AppCompat. -->
    <TextView
        android:id="@+id/quiet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/widget_check"
        android:drawablePadding="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:visibility="gone"
        tools:ignore="UseCompatTextViewDrawableXml" />

    <TextView
        android:id="@+id/section1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_ink_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_row"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/row1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/row1_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/row1_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- The row's end padding, when there is no remind button to end it.
             A view, not padding set from code: setViewPadding is
             left/right, and would be wrong in a right-to-left layout. -->
        <FrameLayout
            android:id="@+id/row1_gap"
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/row1_remind"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:scaleType="center"
            android:src="@drawable/widget_mail"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <TextView
        android:id="@+id/section2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
