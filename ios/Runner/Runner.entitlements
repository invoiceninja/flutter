<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links for shared record links, invoiceninja/flutter#144.
	     Only the hosted host can be claimed (Apple needs a literal), and it must
	     be enabled as an Associated Domains capability on the App ID before this
	     merges or device builds stop provisioning — see APP_LINKS.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:invoicing.co</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Where the Share Extension leaves files shared into the app
	     (invoiceninja/flutter#173); AppDelegate.swift moves them out. Must be
	     registered and enabled on the App ID before this merges, or device and
	     App Store builds stop provisioning — docs/store-deployment-setup.md. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.invoiceninja.admin</string>
	</array>
</dict>
</plist>
