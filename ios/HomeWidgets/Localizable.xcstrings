        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فاکتورهای سررسیدگذشته را پیگیری کنید و ببینید چه چیزی این هفته سررسید می‌شود. برای باز کردن روی یکی ضربه بزنید."
          }
        },
        "fi" : {
          "stringUnit" : {
