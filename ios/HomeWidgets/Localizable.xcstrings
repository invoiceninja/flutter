    "Chase past-due invoices and see what's due this week. Tap one to open it." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg agterstallige fakture op en sien wat hierdie week verskuldig is. Tik op een om dit oop te maak."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع الفواتير المتأخرة واطّلع على المستحق هذا الأسبوع. انقر على أي منها لفتحها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следете просрочените фактури и вижте какво е с падеж тази седмица. Докоснете една, за да я отворите."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes el seguiment de les factures vençudes i mira què venç aquesta setmana. Toca'n una per obrir-la."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upomínejte faktury po splatnosti a sledujte, co je splatné tento týden. Klepnutím fakturu otevřete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg op på forfaldne fakturaer, og se, hvad der forfalder i denne uge. Tryk på en for at åbne den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überfällige Rechnungen nachverfolgen und sehen, was diese Woche fällig ist. Zum Öffnen antippen."
