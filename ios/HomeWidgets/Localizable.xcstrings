        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθήστε τα ληγμένα τιμολόγια και δείτε τι λήγει αυτή την εβδομάδα. Πατήστε ένα για να το ανοίξετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz seguimiento de las facturas vencidas y consulta lo que vence esta semana. Toca una para abrirla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
