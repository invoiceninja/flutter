<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.READ_EXTERNAL_STORAGE" android:required="false" />
    <uses-feature android:name="android.hardware.CALL_PHONE" android:required="false" />

    <application
        android:label="Invoice Ninja"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutter's own deep linking is ON by default (the engine's
                 `deepLinkEnabled` returns true when this key is absent) and
                 would push the raw intent URI in as the initial route, and on
                 `onNewIntent` as route information — bypassing
                 DeepLinkRouter's validation, its company switch and the
                 biometric hold. For the https form below the path is
                 `/app/...`, which matches no go_router route, so the top-level
                 errorBuilder would replace the WHOLE app with the route-error
                 screen; NavStatePersister has no filter for error locations, so
                 that URL then gets restored on every later launch too.
                 `app_links` receives the intent either way — cold through
                 getIntent() in onAttachedToActivity, warm through onNewIntent,
                 which is forwarded to plugins regardless of this flag — so
                 turning it off costs no delivery.
                 MUST sit on the ACTIVITY: shouldHandleDeeplinking() reads
                 ActivityInfo meta-data, and an <application> entry is silently
                 ignored. Pinned by test/lint/universal_links_test.dart. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- OS deep links, bridged into the router by `AppDeepLinks`. Two
                 hosts, deliberately pinned rather than claiming the whole
                 scheme:
                   app                  - shared record links, e.g.
                                          invoiceninja://app/clients/<id>?company=<id>
                   calendar_connection  - the calendar OAuth return, i.e.
                                          invoiceninja://calendar_connection/complete?...handoff=...
                 Android pools <data> attributes per group and matches the
                 CROSS-PRODUCT of them, so these two elements declare
                 {invoiceninja} x {app, calendar_connection} — which is what we
                 want here only because both carry the same scheme. Adding an
                 https <data> to THIS filter would therefore also claim
                 https://app/... and invoiceninja://<that host>/...; universal
                 links need their own filter (they need autoVerify anyway).
                 The Dart-side parser validates the path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="invoiceninja" android:host="app"/>
                <data android:scheme="invoiceninja" android:host="calendar_connection"/>
            </intent-filter>
            <!-- https App Links for shared record links
                 (invoiceninja/flutter#144), e.g.
                 https://invoicing.co/app/invoices/<id>?company=<id>.
                 Its own filter, per the note above: a <data> added to the
                 filter above would cross-product into https://app/... too.
                 Only the hosted host can be here — Android needs a build-time
                 literal, so a self-hosted origin can never be verified; those
                 links route through that instance's own /app/ bridge page,
                 which offers the invoiceninja:// launch instead. See
                 APP_LINKS.md.
                 `pathPrefix` is load-bearing: invoicing.co also serves the
                 client portal and payment pages, and a host-wide claim would
                 hijack them. The trailing slash keeps it off /apply.
                 autoVerify stays OFF the custom-scheme filter above — before
                 Android 12 one failing host failed verification for every
                 autoVerify host in the app. With no assetlinks.json live yet
                 this simply fails verification and links keep opening in the
                 browser; nothing breaks at build or install time. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="invoicing.co" android:pathPrefix="/app/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Android 11 (API 30) package visibility hides every app we don't declare
         here from PackageManager queries. See
         https://developer.android.com/training/package-visibility. -->
    <queries>
        <!-- Required to query activities that can process text, see
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Lets url_launcher's `canLaunchUrl` see an installed browser. Without
             these it returns false for every web URL, and each of the app's
             ~18 external-link call sites reports "failed to open URL" without
             ever attempting the launch: User Guide / Support Forum, client &
             vendor portals, payment links, the upgrade flow, gateway and
             QuickBooks OAuth, and bank reconnect. (`launchUrl` itself would
             have succeeded — package visibility restricts *querying*, not
             starting an implicit intent — so the gate is what fails, and it
             fails silently at build time.) Issue #12.

             `http` alongside `https`: self-hosted portals on internal networks
             are a real case, which is why `isSafeWebUrl`
             (lib/utils/url_safety.dart) permits it. `mailto:` is still absent
             because nothing in the app launches one.

             Guarded by test/lint/android_url_queries_test.dart. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>

        <!-- Tap-to-call / tap-to-message on phone numbers, added for
             invoiceninja/flutter#109 (see docs/tap-to-call.md). These launch
             as ACTION_VIEW, NOT ACTION_CALL: ACTION_VIEW hands the number to
             the dialer pre-filled and the user still presses the call button,
             which is both permission-free and the reason the in-app "Confirm
             before calling" switch can default off — the OS is already asking.
             The `android.permission.CALL_PHONE` declared at the top of this
             file is for ACTION_CALL and is deliberately NOT used. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
    </queries>
</manifest>
