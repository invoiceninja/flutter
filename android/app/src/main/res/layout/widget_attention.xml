    <!-- Spacer: a bare View is not allowed in a RemoteViews layout. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- A tall widget with rows to spare: what is owed in all, over the footer.
         Opens the unpaid invoices. -->
    <LinearLayout
        android:id="@+id/outstanding_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/outstanding_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/outstanding_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/outstanding_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:mirrorForRtl="true"
            android:progressDrawable="@drawable/widget_past_due_bar"
            android:visibility="gone" />

        <TextView
            android:id="@+id/outstanding_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ink_muted"
        android:textSize="11sp" />
</LinearLayout>
