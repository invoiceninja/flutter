<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The home-screen widgets' snapshot and queued commands
	     (docs/home-screen-widgets.md). Team-prefixed: a sandboxed Mac App
	     Store app below macOS 15 can only use a group named after its team.
	     Adding it invalidated the existing Mac App Store profile — see
	     docs/store-deployment-setup.md §3E. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>NPC44Y2C98.com.invoiceninja.admin.widgets</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- The FIRST group is the default one: kSecureStorage names no access
	     group, so the token and the database key live in it. Keep the app's own
	     group first, or an update can no longer read them. The second is the
	     Google Sign-In SDK's (google_sign_in_ios README → macOS integration);
	     without it sign-in fails with a keychain error. The Mac App Store
	     profile allows NPC44Y2C98.*, so it needs no new profile. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.invoiceninja.admin</string>
		<string>$(AppIdentifierPrefix)com.google.GIDSignIn</string>
	</array>
</dict>
</plist>
