                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/row5_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- The row's end padding, when there is no remind button to end it.
             A view, not padding set from code: setViewPadding is
             left/right, and would be wrong in a right-to-left layout. -->
