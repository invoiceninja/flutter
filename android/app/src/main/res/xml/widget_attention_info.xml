<?xml version="1.0" encoding="utf-8"?>
<!-- No updatePeriodMillis: the app pushes every change, and the rollover
     alarm (HomeWidgets.scheduleRollover) covers midnight and staleness. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.invoiceninja.admin.homewidgets.WidgetConfigureActivity"
    android:description="@string/widget_attention_description"
    android:initialLayout="@layout/widget_message"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_attention_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
