    "%@%%" : {

    },
    "A live clock for your running timer. Stop it, or start a recent task, in one tap." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'n Regstreekse horlosie vir jou lopende tydhouer. Stop dit, of begin 'n onlangse taak, met een tik."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعة حية لمؤقتك الجاري. أوقفه أو ابدأ مهمة حديثة بنقرة واحدة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часовник на живо за вашия работещ таймер. Спрете го или стартирайте скорошна задача с едно докосване."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rellotge en directe per al teu temporitzador en curs. Atura'l, o inicia una tasca recent, amb un toc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živé hodiny pro váš běžící časovač. Zastavte ho nebo spusťte nedávnou úlohu jedním klepnutím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et live-ur til din kørende timer. Stop den, eller start en nylig opgave, med ét tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Live-Uhr für Ihren laufenden Timer. Mit einem Tippen anhalten oder eine kürzlich bearbeitete Aufgabe starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζωντανό ρολόι για το ενεργό χρονόμετρό σας. Σταματήστε το ή ξεκινήστε μια πρόσφατη εργασία με ένα πάτημα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un reloj en vivo para tu temporizador en curso. Páralo, o inicia una tarea reciente, con un toque."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un reloj en vivo para tu temporizador en curso. Detenlo, o inicia una tarea reciente, con un toque."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaalajas kell sinu töötavale taimerile. Peata see või alusta hiljutist ülesannet ühe puudutusega."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعت زنده برای تایمر در حال اجرای شما. با یک ضربه متوقفش کنید یا یک وظیفهٔ اخیر را شروع کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaaliaikainen kello käynnissä olevalle ajastimellesi. Pysäytä se tai aloita viimeaikainen tehtävä yhdellä napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une horloge en direct pour votre minuteur en cours. Arrêtez-le, ou démarrez une tâche récente, d'un toucher."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une horloge en direct pour votre minuterie en cours. Arrêtez-la, ou démarrez une tâche récente, d'un toucher."
          }
        },
        "fr-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une horloge en direct pour votre minuteur en cours. Arrêtez-le, ou démarrez une intervention récente, d'un toucher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שעון חי לטיימר הפועל שלך. עצור אותו, או התחל משימה שעבדת עליה לאחרונה, בהקשה אחת."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat uživo za vašu pokrenutu štopericu. Zaustavite je ili pokrenite nedavni zadatak jednim dodirom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élő óra a futó időzítőhöz. Egy koppintással leállíthatja, vagy elindíthat egy legutóbbi feladatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam langsung untuk timer Anda yang sedang berjalan. Hentikan, atau mulai tugas terbaru, dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un orologio in tempo reale per il timer in corso. Fermalo, o avvia un'attività recente, con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のタイマーをライブ時計で表示。ワンタップで停止したり、最近のタスクを開始したりできます。"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "នាឡិកាផ្ទាល់សម្រាប់កម្មវិធីកំណត់ម៉ោងដែលកំពុងដំណើរការរបស់អ្នក។ ឈប់វា ឬចាប់ផ្តើមភារកិច្ចថ្មីៗ ដោយចុចតែម្តង។"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ໂມງສົດສຳລັບໂມງຈັບເວລາທີ່ກຳລັງແລ່ນຂອງທ່ານ. ຢຸດມັນ ຫຼື ເລີ່ມໜ້າວຽກຫຼ້າສຸດ ດ້ວຍການແຕະດຽວ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiesioginis laikrodis jūsų veikiančiam laikmačiui. Sustabdykite jį arba pradėkite neseniai dirbtą darbą vienu bakstelėjimu."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiešsaistes pulkstenis jūsu aktīvajam taimerim. Apturiet to vai sāciet nesenu uzdevumu ar vienu pieskārienu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часовник во живо за вашиот активен тајмер. Сопрете го или започнете неодамнешна задача со еден допир."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En live klokke for den løpende tidtakeren din. Stopp den, eller start en nylig oppgave, med ett trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een live klok voor je lopende timer. Stop hem, of start een recente taak, met één tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegar na żywo dla uruchomionego licznika czasu. Zatrzymaj go lub rozpocznij ostatnie zadanie jednym dotknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relógio ao vivo para seu cronômetro em execução. Pare-o, ou inicie uma tarefa recente, com um toque."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um relógio em direto para o seu cronómetro em execução. Pare-o, ou inicie uma tarefa recente, com um toque."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ceas în timp real pentru cronometrul activ. Opriți-l sau începeți un task recent cu o atingere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы в реальном времени для запущенного таймера. Остановите его или начните недавнюю задачу одним нажатием."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živé hodiny pre váš spustený časovač. Zastavte ho alebo spustite nedávnu úlohu jedným ťuknutím."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ura v živo za vaš delujoči časovnik. Ustavite ga ali začnite nedavno opravilo z enim dotikom."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orë e drejtpërdrejtë për kohëmatësin tënd në ecuri. Ndaloje ose fillo një detyrë të kohëve të fundit me një prekje."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat uživo za vaš pokrenut tajmer. Zaustavite ga ili pokrenite nedavni zadatak jednim dodirom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En liveklocka för din pågående timer. Stoppa den, eller starta en nyligen använd uppgift, med ett tryck."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นาฬิกาแบบสดสำหรับตัวจับเวลาที่กำลังทำงาน หยุด หรือเริ่มงานล่าสุดได้ด้วยการแตะครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışan zamanlayıcınız için canlı saat. Tek dokunuşla durdurun veya son görevlerden birini başlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng hồ trực tiếp cho bộ hẹn giờ đang chạy của bạn. Dừng nó, hoặc bắt đầu một nhiệm vụ gần đây, chỉ với một chạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行中计时器的实时时钟。轻点一下即可停止，或开始最近的任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "執行中計時器的即時時鐘。輕觸一下即可停止，或開始最近的任務。"
